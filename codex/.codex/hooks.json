{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v agent-aws-prod-guard >/dev/null || exit 0; agent-aws-prod-guard --agent codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v agent-notify-ready >/dev/null && agent-notify-ready Codex || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v agent-notify-ready >/dev/null && agent-notify-ready --clear Codex || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
