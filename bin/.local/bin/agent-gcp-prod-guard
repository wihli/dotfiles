#!/usr/bin/env python3
"""Block agent GCP tool calls that target production or perform writes.

Enforces a read-only, dev-only posture for AI-driven ``gcloud``/``gsutil``/``bq``/
``kubectl`` commands routed through an agent's Bash tool. Eric has broad
(global-admin) GCP access with no per-account gating, so this harness-level
PreToolUse hook is the practical safety net until service-account impersonation
scoped to dev exists. It is NOT IAM: it only governs commands an agent runs
through its shell tool. Real enforcement still needs a dev-scoped SA (see the
GCP section of AGENTS.private.md).

Wired identically into Claude Code (``settings.json``) and Codex
(``hooks.json``) as a PreToolUse/Bash hook: both call this script with the
command on stdin and treat exit code 2 as a hard block.

Decision protocol (deny wins, evaluated in order):
  1. Not a GCP command                                   -> allow
  2. References a blocked project id literally            -> deny
  3. Safe meta-read prefix (version/info/config get-value)-> allow
  4. Explicit --project is prod-pattern / not allowlisted -> deny
  5. read_only and command uses a mutating/danger verb    -> deny
  6. enforce_ambient_project and ambient gcloud project
     (or kube context) is prod / not allowlisted          -> deny
  7. otherwise                                           -> allow

Real project ids are Vanta-specific and live in the private config at
$XDG_CONFIG_HOME/agent-gcp-prod-guard/config.json. The in-script defaults ship
safe (fail closed on mutations and *prod* patterns) even with no config.
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Callable

EXIT_ALLOW = 0
EXIT_BLOCK = 2
CIRCUMVENTION_WARNING = (
    "Do not try to circumvent this guard; it protects production and customer data."
)

DEFAULT_CONFIG: dict[str, Any] = {
    "tools": ["gcloud", "gsutil", "bq", "kubectl"],
    # Real ids come from the private config.json. Empty allowlist means the
    # guard enforces via patterns only (still blocks *prod* + all mutations).
    "allowed_projects": [],
    "blocked_projects": [],
    "blocked_project_patterns": ["*prod*", "*production*"],
    "read_only": True,
    "enforce_ambient_project": True,
    "cache_ttl_seconds": 300,
    # Harmless, purely-local/meta reads allowed even when ambient is prod, so an
    # agent can still orient itself. Must be exact command prefixes.
    "always_allow_prefixes": [
        "gcloud version",
        "gcloud --version",
        "gcloud info",
        "gcloud help",
        "gcloud config get-value",
        "gcloud config list",
        "gcloud config configurations list",
        "gcloud auth list",
        "gcloud components list",
        "kubectl version",
        "kubectl config current-context",
        "kubectl config get-contexts",
        "gsutil version",
        "gsutil help",
        "bq version",
        "bq help",
    ],
    # Mutating / dangerous subcommand tokens per tool (deny when read_only).
    "mutating_gcloud": [
        "create", "delete", "update", "patch", "deploy", "set", "unset",
        "enable", "disable", "reset", "restart", "stop", "start", "resize",
        "scale", "replace", "import", "restore", "rollback", "undelete",
        "promote", "migrate", "ssh", "scp", "revoke",
        "add-iam-policy-binding", "remove-iam-policy-binding", "set-iam-policy",
        "print-access-token", "print-identity-token", "activate-service-account",
    ],
    "mutating_gsutil": [
        "rm", "mv", "cp", "rsync", "mb", "rb", "compose", "setmeta", "rewrite",
        "cat", "set", "notification", "retention", "autoclass", "requesterpays",
    ],
    "mutating_bq": [
        "mk", "rm", "cp", "load", "insert", "update", "query", "extract",
        "partition",
    ],
    "mutating_kubectl": [
        "apply", "create", "delete", "edit", "patch", "replace", "scale",
        "annotate", "label", "cordon", "uncordon", "drain", "taint", "rollout",
        "autoscale", "expose", "run", "exec", "cp", "attach", "port-forward",
        "proxy", "debug", "set", "view",
    ],
}


# --------------------------------------------------------------------------- #
# Config / input plumbing
# --------------------------------------------------------------------------- #
def xdg_path(env_name: str, default_suffix: str) -> Path:
    base = os.environ.get(env_name)
    return Path(base) if base else Path.home() / default_suffix


def load_config() -> dict[str, Any]:
    config = dict(DEFAULT_CONFIG)
    path = xdg_path("XDG_CONFIG_HOME", ".config") / "agent-gcp-prod-guard" / "config.json"
    if not path.exists():
        return config
    try:
        user_config = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return config
    for key, value in user_config.items():
        config[key] = value
    return config


def hook_input() -> dict[str, Any]:
    if sys.stdin.isatty():
        return {}
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {}


def command_from_tool(data: dict[str, Any]) -> tuple[str, str]:
    """Extract (tool_name, command) from a Claude Code or Codex hook payload."""
    tool_name = str(data.get("tool_name") or data.get("tool") or "")
    tool_input = data.get("tool_input")
    if not isinstance(tool_input, dict):
        return tool_name, ""
    for key in ("command", "cmd", "shell_command"):
        value = tool_input.get(key)
        if isinstance(value, str):
            return tool_name, value
    value = tool_input.get("input")
    if isinstance(value, str) and is_command_tool(tool_name, ""):
        return tool_name, value
    return tool_name, ""


def is_command_tool(tool_name: str, command: str) -> bool:
    if command:
        return True
    lower = tool_name.lower()
    return any(t in lower for t in ("bash", "shell", "exec", "terminal", "command"))


# --------------------------------------------------------------------------- #
# Parsing helpers
# --------------------------------------------------------------------------- #
def compact_command(command: str) -> str:
    return re.sub(r"\s+", " ", command.strip())


def matches_any(value: str, patterns: list[str]) -> bool:
    lower = value.lower()
    return any(fnmatch.fnmatchcase(lower, p.lower()) for p in patterns)


def has_shell_control_operator(command: str) -> bool:
    return any(tok in command for tok in (";", "&&", "||", "|", "`", "$("))


_BOUNDARY = r"(?:^|[\s=/'\"();|&])"
_END = r"(?=$|[\s='\"();|&])"


def has_token(command: str, token: str) -> bool:
    return re.search(_BOUNDARY + re.escape(token) + _END, command) is not None


# A tool is *invoked* only when it appears at a command position — the start of
# the command, or after a shell separator ( ; | & ( ) { } ` newline && || ),
# optionally preceded by benign wrappers (sudo/env/...) and inline env
# assignments. Plain whitespace is deliberately NOT a separator: that is what
# distinguishes `gcloud ...` (invoked) from `grep gcloud` / commit messages /
# echo text (merely mentioned), which must not trip the guard.
_CMD_START = r"(?:^|[\n;`(){}]|\|\|?|&&?)\s*"
_WRAPPERS = r"(?:(?:sudo|env|command|nohup|time|xargs|watch|stdbuf)\s+(?:-\S+\s+)*)*"
_ENV_ASSIGN = r"(?:[A-Za-z_][A-Za-z0-9_]*=(?:'[^']*'|\"[^\"]*\"|\S*)\s+)*"
_TOOL_END = r"(?=$|[\s;&|)`])"

# Pull PAYLOAD out of shell wrappers like `bash -c '...'` / `zsh -lc "..."` so a
# tool invoked inside a wrapped command is still detected (one level deep).
_SHELL_C_RE = re.compile(
    r"\b(?:ba|z|k|da|a)?sh\b[^\n;&|]*?\s-[a-z]*c\s+('([^']*)'|\"([^\"]*)\")"
)


def _command_strings(command: str):
    """Yield the command plus any shell -c/-lc payloads (one level deep)."""
    yield command
    for m in _SHELL_C_RE.finditer(command):
        payload = m.group(2) if m.group(2) is not None else m.group(3)
        if payload:
            yield payload


def _mask_quoted(s: str) -> str:
    """Blank the contents of quoted spans (keeping length) so shell operators
    *inside* quoted arguments — e.g. `|` in a grep alternation `'(a|gcloud)'` or
    a commit message — are not mistaken for command separators."""
    return re.sub(
        r"'[^']*'|\"[^\"]*\"",
        lambda m: m.group()[0] + "x" * (len(m.group()) - 2) + m.group()[0],
        s,
    )


def tool_invoked(command: str, tool: str) -> bool:
    """True only when `tool` is invoked (command position), not just mentioned.
    Quoted content is masked first so operators inside quotes don't read as
    separators; shell -c payloads are still checked via _command_strings."""
    pattern = re.compile(_CMD_START + _WRAPPERS + _ENV_ASSIGN + re.escape(tool) + _TOOL_END)
    return any(pattern.search(_mask_quoted(s)) for s in _command_strings(command))


def command_matches_prefix(command: str, prefixes: list[str]) -> bool:
    compact = compact_command(command)
    for prefix in prefixes:
        prefix = compact_command(prefix)
        if compact == prefix or compact.startswith(prefix + " "):
            return True
    return False


_PROJECT_FLAG_RE = re.compile(
    r"--project(?:_id|-id)?[= ]\s*(['\"]?)([A-Za-z0-9:._-]+)\1"
)
_PROJECT_ENV_RE = re.compile(
    r"(?:^|[\s;])(?:CLOUDSDK_CORE_PROJECT|GOOGLE_CLOUD_PROJECT|GCLOUD_PROJECT)="
    r"(['\"]?)([A-Za-z0-9:._-]+)\1"
)


def extract_projects(command: str) -> list[str]:
    """Projects named explicitly in the command or the ambient environment."""
    found: list[str] = []
    for m in _PROJECT_FLAG_RE.finditer(command):
        found.append(m.group(2))
    for m in _PROJECT_ENV_RE.finditer(command):
        found.append(m.group(2))
    for env_name in ("CLOUDSDK_CORE_PROJECT", "GOOGLE_CLOUD_PROJECT", "GCLOUD_PROJECT"):
        value = os.environ.get(env_name)
        if value:
            found.append(value)
    return list(dict.fromkeys(found))


def tools_in_command(command: str, config: dict[str, Any]) -> list[str]:
    """gcp tools actually invoked (command position), not merely referenced."""
    return [t for t in config["tools"] if tool_invoked(command, t)]


def is_mutating(command: str, tools: list[str], config: dict[str, Any]) -> str | None:
    """Return the offending token if any invoked tool uses a mutating verb."""
    for tool in tools:
        for token in config.get(f"mutating_{tool}", []):
            if has_token(command, token):
                return f"{tool} {token}"
    return None


def project_disallowed(project: str, config: dict[str, Any]) -> bool:
    if matches_any(project, config["blocked_project_patterns"]):
        return True
    allowed = config.get("allowed_projects") or []
    return bool(allowed) and project not in allowed


# --------------------------------------------------------------------------- #
# Ambient resolution (cached)
# --------------------------------------------------------------------------- #
def _cache_path() -> Path:
    return xdg_path("XDG_CACHE_HOME", ".cache") / "agent-gcp-prod-guard" / "ambient.json"


def _fingerprint() -> str:
    parts = [
        os.environ.get("CLOUDSDK_ACTIVE_CONFIG_NAME", ""),
        os.environ.get("CLOUDSDK_CORE_PROJECT", ""),
        os.environ.get("KUBECONFIG", ""),
    ]
    for rel in ("gcloud/active_config", "gcloud/configurations/config_default"):
        p = xdg_path("XDG_CONFIG_HOME", ".config") / rel
        try:
            st = p.stat()
            parts.append(f"{p}:{st.st_mtime_ns}")
        except OSError:
            parts.append(f"{p}:missing")
    kube = Path(os.environ["KUBECONFIG"]) if os.environ.get("KUBECONFIG") else Path.home() / ".kube/config"
    try:
        st = kube.stat()
        parts.append(f"{kube}:{st.st_mtime_ns}")
    except OSError:
        parts.append(f"{kube}:missing")
    return hashlib.sha256("\n".join(parts).encode()).hexdigest()


def _run(cmd: list[str]) -> str | None:
    try:
        result = subprocess.run(
            cmd, check=False, text=True, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=2,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return None
    out = (result.stdout or "").strip()
    if result.returncode != 0 or not out or out == "(unset)":
        return None
    return out


def resolve_ambient(config: dict[str, Any]) -> dict[str, str | None]:
    """Best-effort ambient gcloud project + kube context, cached by TTL/fingerprint."""
    fingerprint = _fingerprint()
    path = _cache_path()
    try:
        cached = json.loads(path.read_text())
        if (
            cached.get("fingerprint") == fingerprint
            and int(cached.get("expires_at", 0)) > int(time.time())
        ):
            return {"project": cached.get("project"), "kube_context": cached.get("kube_context")}
    except (OSError, json.JSONDecodeError, ValueError):
        pass

    result = {
        "project": _run(["gcloud", "config", "get-value", "project", "-q"]),
        "kube_context": _run(["kubectl", "config", "current-context"]),
    }
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps({
            **result,
            "fingerprint": fingerprint,
            "expires_at": int(time.time()) + int(config["cache_ttl_seconds"]),
        }) + "\n")
    except OSError:
        pass
    return result


# --------------------------------------------------------------------------- #
# Core decision (pure — shared by main() and tests)
# --------------------------------------------------------------------------- #
def decide(
    tool_name: str,
    command: str,
    config: dict[str, Any],
    ambient: Callable[[dict[str, Any]], dict[str, str | None]] = resolve_ambient,
) -> tuple[str, str]:
    """Return ('allow', '') or ('deny', reason). Pure given the ambient resolver."""
    if not is_command_tool(tool_name, command) or not command:
        return "allow", ""
    compact = compact_command(command)
    tools = tools_in_command(compact, config)
    if not tools:
        return "allow", ""

    # 2. blocked project referenced literally anywhere (catches --project=prod,
    #    gs://prod buckets, kube args, etc.)
    lower = compact.lower()
    for pid in config.get("blocked_projects", []):
        if pid and pid.lower() in lower:
            return "deny", f"references blocked project '{pid}'"

    # 3. harmless meta reads (only when not chaining other commands)
    if command_matches_prefix(compact, config["always_allow_prefixes"]) and not \
            has_shell_control_operator(compact):
        return "allow", ""

    # 4. explicit project must be allowlisted / non-prod
    for project in extract_projects(compact):
        if project_disallowed(project, config):
            return "deny", (
                f"project '{project}' is not in the allowed set "
                f"{config.get('allowed_projects') or ['<none configured>']}"
            )

    # 5. read-only posture
    if config.get("read_only", True):
        offending = is_mutating(compact, tools, config)
        if offending:
            return "deny", f"mutating operation '{offending}' blocked (read-only mode)"

    # 6. ambient project / kube context enforcement
    if config.get("enforce_ambient_project", True):
        explicit = extract_projects(compact)
        cloud_tools = [t for t in tools if t in ("gcloud", "gsutil", "bq")]
        need_ambient = (cloud_tools and not explicit) or "kubectl" in tools
        if need_ambient:
            resolved = ambient(config)
            proj = resolved.get("project")
            if cloud_tools and not explicit and proj and project_disallowed(proj, config):
                return "deny", (
                    f"ambient gcloud project '{proj}' is not allowed; "
                    "run: gcloud config set project <dev-project>"
                )
            ctx = resolved.get("kube_context")
            if "kubectl" in tools and ctx and matches_any(
                ctx, config["blocked_project_patterns"]
            ):
                return "deny", f"kube context '{ctx}' looks like production"

    return "allow", ""


# --------------------------------------------------------------------------- #
def log_event(event: str, detail: str) -> None:
    state_dir = xdg_path("XDG_STATE_HOME", ".local/state") / "agent-gcp-prod-guard"
    try:
        state_dir.mkdir(parents=True, exist_ok=True)
        with (state_dir / "events.log").open("a") as f:
            ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            f.write(f"{ts} event={event} detail={detail}\n")
    except OSError:
        pass


def deny(reason: str, agent: str) -> int:
    message = f"GCP prod guard: {reason}. {CIRCUMVENTION_WARNING}"
    print(message, file=sys.stderr)
    print(json.dumps({
        "permissionDecision": "deny",
        "permissionDecisionReason": message,
    }))
    log_event("deny", f"agent={agent} {reason}")
    return EXIT_BLOCK


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--agent", default="agent")
    args = parser.parse_args()

    config = load_config()
    data = hook_input()
    tool_name, command = command_from_tool(data)
    decision, reason = decide(tool_name, command, config)
    if decision == "deny":
        return deny(reason, args.agent)
    return EXIT_ALLOW


if __name__ == "__main__":
    raise SystemExit(main())
