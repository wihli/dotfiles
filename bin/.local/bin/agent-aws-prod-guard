#!/usr/bin/env python3
"""Block risky agent tool calls when ambient AWS auth points at production."""

from __future__ import annotations

import argparse
import configparser
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any


EXIT_ALLOW = 0
EXIT_BLOCK = 2
CIRCUMVENTION_WARNING = (
    "Do not try to circumvent this failure; it is there for a reason."
)

DEFAULT_CONFIG: dict[str, Any] = {
    "production_account_ids": [],
    "non_production_account_ids": [],
    "production_profile_patterns": [
        "prod",
        "prod-*",
        "*-prod",
        "*prod*",
        "production",
        "*production*",
    ],
    "safe_profile_patterns": [
        "dev",
        "dev-*",
        "*-dev",
        "staging",
        "*staging*",
        "sandbox",
        "*sandbox*",
        "test",
        "*test*",
        "local",
    ],
    "safe_commands_when_prod": [
        "pup",
        "DD_SITE=ddog-gov.com pup",
        "DD_SITE=datadoghq.com pup",
        "pwd",
        "ls",
        "find",
        "rg",
        "grep",
        "sed",
        "awk",
        "cat",
        "nl",
        "head",
        "tail",
        "wc",
        "stat",
        "file",
        "du",
        "df",
        "git status",
        "git diff",
        "git log",
        "git show",
        "git branch",
        "git rev-parse",
        "git ls-files",
        "git grep",
    ],
    "risky_command_patterns": [
        "* aws *",
        "aws *",
        "* aws-vault *",
        "aws-vault *",
        "* terraform *",
        "terraform *",
        "* tofu *",
        "tofu *",
        "* terragrunt *",
        "terragrunt *",
        "* cdk *",
        "cdk *",
        "* pulumi *",
        "pulumi *",
        "* sam *",
        "sam *",
        "* serverless *",
        "serverless *",
        "* sls *",
        "sls *",
        "kubectl *",
        "helm *",
    ],
    "risky_command_tools": [
        "aws",
        "aws-vault",
        "terraform",
        "tofu",
        "terragrunt",
        "cdk",
        "pulumi",
        "sam",
        "serverless",
        "sls",
        "kubectl",
        "helm",
    ],
    "cache_ttl_seconds": 900,
    "allow_sts_fallback": True,
}


@dataclass
class Identity:
    state: str
    reason: str
    profile: str | None = None
    account_id: str | None = None
    arn: str | None = None


def xdg_path(env_name: str, default_suffix: str) -> Path:
    base = os.environ.get(env_name)
    if base:
        return Path(base)
    return Path.home() / default_suffix


def load_config() -> dict[str, Any]:
    config = dict(DEFAULT_CONFIG)
    path = (
        xdg_path("XDG_CONFIG_HOME", ".config")
        / "agent-aws-prod-guard"
        / "config.json"
    )
    if not path.exists():
        return config

    with path.open() as f:
        user_config = json.load(f)
    for key, value in user_config.items():
        if isinstance(value, list) and isinstance(config.get(key), list):
            config[key] = value
        else:
            config[key] = value
    return config


def hook_input() -> dict[str, Any]:
    if sys.stdin.isatty():
        return {}
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    return json.loads(raw)


def command_from_tool(data: dict[str, Any]) -> tuple[str, str]:
    tool_name = str(data.get("tool_name") or data.get("tool") or "")
    tool_input = data.get("tool_input")
    if not isinstance(tool_input, dict):
        return tool_name, ""

    for key in ("command", "cmd", "shell_command"):
        value = tool_input.get(key)
        if isinstance(value, str):
            return tool_name, value
    value = tool_input.get("input")
    if isinstance(value, str) and is_command_tool(tool_name, ""):
        return tool_name, value
    return tool_name, ""


def is_command_tool(tool_name: str, command: str) -> bool:
    if command:
        return True
    lower = tool_name.lower()
    return any(
        token in lower
        for token in ("bash", "shell", "exec", "terminal", "command")
    )


def compact_command(command: str) -> str:
    return re.sub(r"\s+", " ", command.strip())


def matches_any(value: str, patterns: list[str]) -> bool:
    lower = value.lower()
    return any(fnmatch.fnmatchcase(lower, pattern.lower()) for pattern in patterns)


def command_matches_prefix(command: str, prefixes: list[str]) -> bool:
    compact = compact_command(command)
    for prefix in prefixes:
        prefix = compact_command(prefix)
        if compact == prefix or compact.startswith(prefix + " "):
            return True
    return False


def has_shell_control_operator(command: str) -> bool:
    return any(token in command for token in (";", "&&", "||", "|", "`", "$("))


def command_contains_tool(command: str, tools: list[str]) -> bool:
    command_delimiter = r"(^|[\s;&|`'\"($(/])"
    token_end = r"(?=$|[\s;&|`'\"),/])"
    for tool in tools:
        if re.search(command_delimiter + re.escape(tool) + token_end, command):
            return True
    return False


def risky_command(command: str, config: dict[str, Any]) -> bool:
    compact = compact_command(command)
    padded = f" {compact} "
    direct_profile = command_profile(command)
    if direct_profile and matches_any(
        direct_profile, config["production_profile_patterns"]
    ):
        return True
    if command_contains_tool(compact, config.get("risky_command_tools", [])):
        return True
    return matches_any(compact, config["risky_command_patterns"]) or matches_any(
        padded, config["risky_command_patterns"]
    )


def command_profile(command: str) -> str | None:
    match = re.search(
        r"(?:^|[\s;])AWS_(?:DEFAULT_)?PROFILE=(['\"]?)([^'\"\s;]+)\1",
        command,
    )
    if match:
        return match.group(2)

    match = re.search(r"(?:^|[\s;])AWS_VAULT=(['\"]?)([^'\"\s;]+)\1", command)
    if match:
        return match.group(2)

    match = re.search(
        r"(?:^|[\s;])aws-vault\s+exec\s+(['\"]?)([^'\"\s;]+)\1",
        command,
    )
    if match:
        return match.group(2)

    return None


def account_from_arn(arn: str | None) -> str | None:
    if not arn:
        return None
    match = re.match(r"arn:[^:]*:[^:]*::([0-9]{12}):", arn)
    return match.group(1) if match else None


def aws_config_paths() -> tuple[Path, Path]:
    config_path = Path(os.environ.get("AWS_CONFIG_FILE", Path.home() / ".aws/config"))
    creds_path = Path(
        os.environ.get("AWS_SHARED_CREDENTIALS_FILE", Path.home() / ".aws/credentials")
    )
    return config_path, creds_path


def read_aws_ini(path: Path, is_config: bool) -> configparser.RawConfigParser:
    parser = configparser.RawConfigParser()
    if path.exists():
        parser.read(path)
    if is_config:
        for section in list(parser.sections()):
            if section.startswith("profile "):
                normalized = section.removeprefix("profile ")
                if not parser.has_section(normalized):
                    parser.add_section(normalized)
                for key, value in parser.items(section):
                    parser.set(normalized, key, value)
    return parser


def profile_exists(
    profile: str,
    config_parser: configparser.RawConfigParser,
    creds_parser: configparser.RawConfigParser,
) -> bool:
    return config_parser.has_section(profile) or creds_parser.has_section(profile)


def profile_value(
    profile: str,
    key: str,
    config_parser: configparser.RawConfigParser,
    creds_parser: configparser.RawConfigParser,
) -> str | None:
    for parser in (config_parser, creds_parser):
        if parser.has_section(profile) and parser.has_option(profile, key):
            return parser.get(profile, key).strip()
    return None


def account_is_prod(account_id: str | None, config: dict[str, Any]) -> bool:
    return bool(account_id and account_id in config["production_account_ids"])


def account_is_nonprod(account_id: str | None, config: dict[str, Any]) -> bool:
    return bool(account_id and account_id in config["non_production_account_ids"])


def classify_profile(
    profile: str,
    config: dict[str, Any],
    config_parser: configparser.RawConfigParser,
    creds_parser: configparser.RawConfigParser,
    seen: set[str] | None = None,
) -> Identity:
    seen = seen or set()
    if profile in seen:
        return Identity("ambiguous", f"profile cycle at {profile}", profile=profile)
    seen.add(profile)

    role_arn = profile_value(profile, "role_arn", config_parser, creds_parser)
    account_id = profile_value(profile, "sso_account_id", config_parser, creds_parser)
    account_id = account_id or account_from_arn(role_arn)

    if account_is_prod(account_id, config):
        return Identity("prod", "configured production account", profile, account_id, role_arn)
    if account_is_nonprod(account_id, config):
        return Identity("safe", "configured non-production account", profile, account_id, role_arn)
    if matches_any(profile, config["production_profile_patterns"]):
        return Identity("prod", "production profile pattern", profile, account_id, role_arn)
    if matches_any(profile, config["safe_profile_patterns"]):
        return Identity("safe", "safe profile pattern", profile, account_id, role_arn)

    source = profile_value(profile, "source_profile", config_parser, creds_parser)
    if source:
        upstream = classify_profile(source, config, config_parser, creds_parser, seen)
        if upstream.state != "ambiguous":
            upstream.profile = profile
            return upstream

    if account_id:
        return Identity("ambiguous", "account id is not classified", profile, account_id, role_arn)
    if profile_exists(profile, config_parser, creds_parser):
        return Identity("ambiguous", "profile exists but is not classified", profile)
    return Identity("ambiguous", "profile is not present in local AWS config", profile)


def local_identity(command: str, config: dict[str, Any]) -> Identity:
    cmd_profile = command_profile(command)
    env_profile = (
        os.environ.get("AWS_VAULT")
        or os.environ.get("AWS_PROFILE")
        or os.environ.get("AWS_DEFAULT_PROFILE")
    )
    role_arn = os.environ.get("AWS_ROLE_ARN")
    account_id = account_from_arn(role_arn)
    if account_is_prod(account_id, config):
        return Identity(
            "prod",
            "AWS_ROLE_ARN production account",
            env_profile,
            account_id,
            role_arn,
        )
    if account_is_nonprod(account_id, config):
        return Identity(
            "safe",
            "AWS_ROLE_ARN non-production account",
            env_profile,
            account_id,
            role_arn,
        )

    config_path, creds_path = aws_config_paths()
    config_parser = read_aws_ini(config_path, is_config=True)
    creds_parser = read_aws_ini(creds_path, is_config=False)

    profile = cmd_profile or env_profile
    if profile:
        return classify_profile(profile, config, config_parser, creds_parser)

    if (
        os.environ.get("AWS_ACCESS_KEY_ID")
        or os.environ.get("AWS_SESSION_TOKEN")
        or os.environ.get("AWS_SECURITY_TOKEN")
    ):
        return Identity("ambiguous", "AWS credential environment variables are set")

    if profile_exists("default", config_parser, creds_parser):
        return classify_profile("default", config, config_parser, creds_parser)

    return Identity("none", "no ambient AWS identity detected")


def file_signature(path: Path) -> str:
    try:
        stat = path.stat()
        return f"{path}:{stat.st_mtime_ns}:{stat.st_size}"
    except FileNotFoundError:
        return f"{path}:missing"


def source_fingerprint(command: str) -> str:
    config_path, creds_path = aws_config_paths()
    parts = [
        f"AWS_PROFILE={os.environ.get('AWS_PROFILE', '')}",
        f"AWS_DEFAULT_PROFILE={os.environ.get('AWS_DEFAULT_PROFILE', '')}",
        f"AWS_VAULT={os.environ.get('AWS_VAULT', '')}",
        f"AWS_ROLE_ARN={os.environ.get('AWS_ROLE_ARN', '')}",
        f"AWS_ACCESS_KEY_ID={os.environ.get('AWS_ACCESS_KEY_ID', '')[:8]}",
        f"command_profile={command_profile(command) or ''}",
        file_signature(config_path),
        file_signature(creds_path),
    ]
    return hashlib.sha256("\n".join(parts).encode()).hexdigest()


def cache_path() -> Path:
    return (
        xdg_path("XDG_CACHE_HOME", ".cache")
        / "agent-aws-prod-guard"
        / "identity.json"
    )


def cached_identity(fingerprint: str) -> Identity | None:
    path = cache_path()
    try:
        data = json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return None
    if data.get("source_fingerprint") != fingerprint:
        return None
    if int(data.get("expires_at", 0)) <= int(time.time()):
        return None
    return Identity(
        data.get("state", "ambiguous"),
        "cached STS identity",
        data.get("profile"),
        data.get("account_id"),
        data.get("arn"),
    )


def write_cached_identity(identity: Identity, fingerprint: str, ttl_seconds: int) -> None:
    path = cache_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "state": identity.state,
        "reason": identity.reason,
        "profile": identity.profile,
        "account_id": identity.account_id,
        "arn": identity.arn,
        "source_fingerprint": fingerprint,
        "expires_at": int(time.time()) + ttl_seconds,
    }
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")


def sts_identity(command: str, config: dict[str, Any]) -> Identity:
    fingerprint = source_fingerprint(command)
    cached = cached_identity(fingerprint)
    if cached:
        return cached

    if not config.get("allow_sts_fallback", True):
        return Identity("ambiguous", "STS fallback disabled")

    try:
        result = subprocess.run(
            ["aws", "sts", "get-caller-identity", "--output", "json"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=2,
            env={**os.environ, "AWS_PAGER": ""},
        )
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return Identity("ambiguous", f"STS fallback failed: {exc}")

    if result.returncode != 0:
        return Identity("ambiguous", "STS fallback returned non-zero")

    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return Identity("ambiguous", "STS fallback returned invalid JSON")

    account_id = str(data.get("Account") or "")
    arn = str(data.get("Arn") or "")
    profile = (
        command_profile(command)
        or os.environ.get("AWS_VAULT")
        or os.environ.get("AWS_PROFILE")
        or os.environ.get("AWS_DEFAULT_PROFILE")
    )
    if account_is_prod(account_id, config) or matches_any(
        profile or "", config["production_profile_patterns"]
    ):
        identity = Identity("prod", "STS production identity", profile, account_id, arn)
    elif account_is_nonprod(account_id, config) or matches_any(
        profile or "", config["safe_profile_patterns"]
    ):
        identity = Identity("safe", "STS non-production identity", profile, account_id, arn)
    else:
        identity = Identity("ambiguous", "STS account is not classified", profile, account_id, arn)

    write_cached_identity(identity, fingerprint, int(config["cache_ttl_seconds"]))
    return identity


def log_event(event: str, detail: str) -> None:
    state_dir = xdg_path("XDG_STATE_HOME", ".local/state") / "agent-aws-prod-guard"
    try:
        state_dir.mkdir(parents=True, exist_ok=True)
        with (state_dir / "events.log").open("a") as f:
            timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            f.write(f"{timestamp} event={event} detail={detail}\n")
    except OSError:
        pass


def deny(reason: str) -> int:
    reason = f"{reason} {CIRCUMVENTION_WARNING}"
    print(reason, file=sys.stderr)
    print(
        json.dumps(
            {
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        )
    )
    log_event("deny", reason)
    return EXIT_BLOCK


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--agent", default="agent")
    parser.parse_args()

    config = load_config()
    data = hook_input()
    tool_name, command = command_from_tool(data)
    if not is_command_tool(tool_name, command):
        return EXIT_ALLOW
    if not command:
        return EXIT_ALLOW

    if command_matches_prefix(
        command, config["safe_commands_when_prod"]
    ) and not has_shell_control_operator(command):
        return EXIT_ALLOW

    local = local_identity(command, config)
    is_risky = risky_command(command, config)

    if local.state == "prod" and is_risky:
        return deny(
            f"AWS prod guard: refusing {tool_name or 'tool'} command while {local.reason}"
            f" (profile={local.profile or 'unknown'}, account={local.account_id or 'unknown'})."
        )
    if local.state in ("safe", "none"):
        return EXIT_ALLOW
    if not is_risky:
        return EXIT_ALLOW

    fallback = sts_identity(command, config)
    if fallback.state == "prod":
        return deny(
            f"AWS prod guard: refusing risky command while STS reports production"
            f" (profile={fallback.profile or 'unknown'}, account={fallback.account_id or 'unknown'})."
        )
    if fallback.state == "safe":
        return EXIT_ALLOW

    return deny(
        f"AWS prod guard: refusing risky command because AWS identity is ambiguous"
        f" ({fallback.reason}; profile={fallback.profile or local.profile or 'unknown'})."
    )


if __name__ == "__main__":
    raise SystemExit(main())
