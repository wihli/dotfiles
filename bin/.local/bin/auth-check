#!/usr/bin/env bash
# One-shot auth-status preflight across the CLIs used in agent sessions.
# Replaces the manual `!<tool> auth status` ritual. Skips tools not installed.
#
# Usage: auth-check [--quiet] [--strict]
#   --quiet   only print tools that need attention
#   --strict  exit non-zero if any installed tool is not authenticated

set -uo pipefail

QUIET=0; STRICT=0
for a in "$@"; do
  case "$a" in
    --quiet) QUIET=1 ;;
    --strict) STRICT=1 ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown arg: $a" >&2; exit 1 ;;
  esac
done

# Run with a timeout when one is available (auth checks can hang on network).
TIMEOUT=""
for t in timeout gtimeout; do command -v "$t" >/dev/null && { TIMEOUT="$t 8"; break; }; done

fails=0
# check <label> <bin> <predicate-cmd> <login-hint>
check() {
  local label="$1" bin="$2" cmd="$3" hint="$4"
  if ! command -v "$bin" >/dev/null 2>&1; then
    [ "$QUIET" = 1 ] || printf '  %-12s —  not installed\n' "$label"
    return
  fi
  if $TIMEOUT bash -c "$cmd" >/dev/null 2>&1; then
    [ "$QUIET" = 1 ] || printf '  %-12s \033[32mok\033[0m\n' "$label"
  else
    printf '  %-12s \033[31mNEEDS LOGIN\033[0m  -> %s\n' "$label" "$hint"
    fails=$((fails+1))
  fi
}

echo "auth-check:"
check github   gh          "gh auth status"                 "gh auth login"
check gcloud   gcloud      "[ -n \"\$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null)\" ]" "gcloud auth login"
check jira     acli        "acli jira auth status"          "acli jira auth login"
check datadog  pup         "pup auth status"                "pup auth login --ro"
check gworksp  gws         "gws auth status"                "gws auth login"
check slack    slack-vanta "slack-vanta auth status"        "slack-vanta auth login"

if [ "$fails" -gt 0 ]; then
  echo "$fails tool(s) need attention."
  [ "$STRICT" = 1 ] && exit 1
fi
exit 0
